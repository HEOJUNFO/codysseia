# 복사해서 .env 로 쓰세요 (.env 는 커밋되지 않습니다)
#
# 게임에 필요한 키는 없습니다.
# 게임 속 GM 과 hindsight 메모리는 모두 호스트 본인의 Codex(ChatGPT) 로그인을 씁니다 (대전제 2.4).
# OpenAI API 키를 여기에 넣어 쓰는 방식은 채택하지 않았습니다.

# ai-town (tools/ai-town/run.sh) 전용. 개발 참고 도구에만 쓰고 게임 GM 에는 넘기지 않는다.
AI_TOWN_OPENAI_API_KEY=
# 비우면 ai-town 기본값 (gpt-4o-mini / text-embedding-ada-002). 임베딩은 1536 차원 모델만 된다.
AI_TOWN_OPENAI_CHAT_MODEL=
AI_TOWN_OPENAI_EMBEDDING_MODEL=
