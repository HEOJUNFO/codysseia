{
  "name": "codysseia",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/engine",
    "src/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @codysseia/web",
    "build": "npm run build -w @codysseia/web",
    "lint": "npm run lint -w @codysseia/web",
    "test": "npm test -w @codysseia/engine && node --test \"src/game/test/*.test.ts\" \"src/gm/test/*.test.ts\"",
    "typecheck": "npm run typecheck -w @codysseia/engine"
  },
  "engines": {
    "node": ">=22.18"
  }
}
